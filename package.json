{
  "name": "study-os",
  "productName": "StudyOS",
  "description": "A local-first study workspace for PDFs, videos, projects, captures and flashcards.",
  "author": "StudyOS",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "desktop": "npm run build && electron .",
    "installer": "npm run build && electron-builder --win nsis",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "plyr": "3.8.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "electron": "33.4.11",
    "electron-builder": "^26.18.0",
    "svelte": "5.57.2",
    "typescript": "5.7.3",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.studyos.desktop",
    "productName": "StudyOS",
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "ar"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asarUnpack": [
      "**/stt.py",
      "electron/stt.py"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StudyOS",
      "artifactName": "StudyOS-Setup-${version}.${ext}"
    }
  }
}
