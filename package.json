{
  "name": "makeen",
  "productName": "Makeen",
  "description": "Makeen (مَكِين) — A local-first study workspace for PDFs, videos, projects, captures and flashcards.",
  "author": "Makeen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mubnaly/makeen.git"
  },
  "bugs": {
    "url": "https://github.com/mubnaly/makeen/issues"
  },
  "homepage": "https://github.com/mubnaly/makeen#readme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "desktop": "npm run build && electron .",
    "installer": "npm run build && electron-builder --win nsis",
    "mobile:sync": "npm run build && npx cap sync android",
    "mobile:open": "npx cap open android",
    "mobile:build": "npm run build && npx cap sync android && cd android && gradlew.bat :app:assembleDebug && cd .. && copy android\\app\\build\\outputs\\apk\\debug\\app-debug.apk release\\Makeen.apk",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "plyr": "3.8.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "electron": "33.4.11",
    "electron-builder": "^26.18.0",
    "svelte": "5.57.2",
    "typescript": "5.7.3",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.makeen.desktop",
    "productName": "Makeen",
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "ar"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "build/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asarUnpack": [
      "**/stt.py",
      "electron/stt.py"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Makeen",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "Makeen-Setup-${version}.${ext}"
    }
  }
}
